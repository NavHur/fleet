# Symlinks bin/sync keeps in place. One per line:
#   <path under ~>  <path in this repo>  [if:<path under ~ that must exist>]
# {host} is this machine's name in hosts/. A missing repo path is skipped.
.local/bin/axe-review                   skills/axe-review/scripts/scan.mjs
.local/bin/shots                        lib/shots/shots.mjs
.local/bin/host-check                   bin/host-check
.local/bin/bg-job                       bin/bg-job
.local/bin/idle-compact                 bin/idle-compact
.local/bin/actions-runners              bin/actions-runners
.local/bin/file-size                    lib/file-size/file_size.py
.local/lib/host-check                   lib/host-check
.config/fleet/host.json                 hosts/{host}/host.json
.config/fleet/runners.json              hosts/{host}/runners.json
.config/t3-orchestration.md             config/t3-orchestration.md
.config/fleet/agent-shell.zsh           config/agent-shell.zsh
.config/fleet/login-path.sh             config/login-path.sh
.claude/hooks/merge-guard.py            hosts/{host}/claude-hooks/merge-guard.py
.claude/hooks/agent-cli-guard.py        hosts/{host}/claude-hooks/agent-cli-guard.py
.claude/hooks/migration-guard.py        hosts/{host}/claude-hooks/migration-guard.py
.config/systemd/user/builds.slice       hosts/{host}/builds.slice
.config/systemd/user/app-t3code.slice.d/priority.conf  hosts/{host}/systemd/app-t3code.slice.d/priority.conf  if:.config/systemd
.config/systemd/user/app-t3code-agents.slice.d/priority.conf  hosts/{host}/systemd/app-t3code-agents.slice.d/priority.conf  if:.config/systemd
.config/systemd/user/idle-compact.service  config/idle-compact/idle-compact.service  if:.config/systemd
.config/systemd/user/idle-compact.timer    config/idle-compact/idle-compact.timer    if:.config/systemd
.config/opencode/plugins/host-check.js  lib/host-check/opencode-plugin.js  if:.config/opencode
.config/systemd/user/actions-runner@.service  config/actions-runner/actions-runner@.service  if:.config/fleet/runners.json
