[Unit]
Description=Shared validation jobs started through host-check

[Slice]
# Weight 250 against app.slice at 1000 (T3, agent sessions, previews): when
# both want every core, builds get 250/1250 = 20% (about 1.6 of 8 vCPUs), so
# they keep moving and agents waiting on them are not stalled. Whatever app.slice
# leaves unused goes to builds too, up to all 8 vCPUs.
CPUWeight=250
# IOWeight only takes effect if the io controller is delegated to user@1000.
IOWeight=100
# Reclaim build memory first, and OOM-kill builds rather than services.
MemoryHigh=18G
MemoryMax=22G
