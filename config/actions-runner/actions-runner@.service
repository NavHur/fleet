[Unit]
Description=GitHub Actions runner for %i
After=network-online.target

[Service]
WorkingDirectory=%h/.local/share/actions-runners/%i
# The runner's own service entry point: it exports PATH from .path, which run.sh ignores.
ExecStart=%h/.local/share/actions-runners/%i/bin/runsvc.sh
Slice=builds.slice
Nice=10
# runsvc.sh hands SIGTERM to the runner, which cancels its job; killing the whole group would cut that off.
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
