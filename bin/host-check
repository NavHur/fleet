#!/usr/bin/env python3
"""Queue a validation command so agents on this machine share the CPU.

One job per physical Git worktree, and host-wide caps on all jobs, heavy jobs
(whole suites and builds), and builds, from ~/.config/fleet/host.json. On
Linux the job runs in a systemd user slice whose CPU and memory limits the
kernel enforces; on macOS it runs under a taskpolicy QoS clamp, so it yields
the CPU to interactive work. Lock files live in ~/.cache/host-check and are
held by the command and every child that inherits them. Each finished job
appends its wait, run time, and exit status to jobs.jsonl there.
"""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import platform
import shlex
import shutil
import signal
import subprocess
import sys
import time

LIB = Path(os.path.realpath(__file__)).parent.parent / "lib" / "host-check"
sys.path.insert(0, str(LIB))
import hostconf  # noqa: E402

CLASSES = ("build", "heavy", "light")
# The slot each job class takes: a job that runs no validation still takes a light one.
SLOT_CLASS = {"none": "light", "light": "light", "heavy": "heavy", "build": "build"}


def say(message):
    print(f"host-check: {message}", file=sys.stderr, flush=True)


def usage(conf):
    print("Usage: host-check COMMAND [ARG ...]")
    builds = "build" if conf["build_slots"] == 1 else "builds"
    print(f"One job per worktree; up to {conf['slots']} jobs, {conf['heavy_slots']} heavy "
          f"(whole suites and builds), {conf['build_slots']} {builds}.")
    print(f"Vitest defaults to {conf['vitest_max_workers']} workers. "
          "HOST_CHECK_CLASS=build|heavy|light overrides the detected class.")
    print("Run from the target worktree. Wrap a command or pipeline, never both.")
    print("HOST_CHECK_LABEL tags the job in ~/.cache/host-check/jobs.jsonl.")
    print(f"Policy: {hostconf.HOST_VALIDATION}")


def open_lock(path):
    return os.open(path, os.O_WRONLY | os.O_CREAT, 0o600)


def wait_for(fd, mode, describe, started):
    """Block until the lock is held, reporting every ten seconds."""
    next_report = time.monotonic() + 10
    while True:
        try:
            fcntl.flock(fd, mode | fcntl.LOCK_NB)
            return
        except BlockingIOError:
            pass
        if time.monotonic() >= next_report:
            say(f"waiting for {describe()} ({int(time.monotonic() - started)}s)")
            next_report += 10
        time.sleep(0.2)


def worktree_root():
    try:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True,
                             text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        top = os.getcwd()
    return os.path.realpath(top or os.getcwd())


def classify(argv):
    """The slot class a job takes: HOST_CHECK_CLASS, else the job class catalogue's answer."""
    chosen = os.environ.get("HOST_CHECK_CLASS")
    if chosen in CLASSES:
        return chosen
    try:
        import jobclass
        return SLOT_CLASS[jobclass.job_class(shlex.join(argv))]
    except Exception:
        # A broken catalogue stops the job instead of making every job heavy.
        say("could not classify the job; HOST_CHECK_CLASS=build|heavy|light before host-check overrides it")
        raise


def launcher(conf):
    """The command prefix that applies this machine's CPU policy."""
    nice = ["nice", "-n", str(conf["nice"])] if conf["nice"] else []
    if platform.system() == "Darwin":
        if conf["qos_clamp"] and shutil.which("taskpolicy"):
            return ["taskpolicy", "-c", conf["qos_clamp"], *nice], f"QoS clamp {conf['qos_clamp']}"
        return nice, "without a QoS clamp"
    if conf["slice"]:
        bus = subprocess.run(["systemctl", "--user", "show-environment"],
                             capture_output=True).returncode == 0 if shutil.which("systemctl") else False
        if bus:
            # systemd 259 expands $VAR in the command unless told not to.
            return (["systemd-run", "--user", "--scope", "--quiet", "--collect", "--expand-environment=no",
                     f"--slice={conf['slice']}", *nice], conf["slice"])
        say(f"no user systemd bus; running outside {conf['slice']}")
    return ["nice", "-n", str(max(conf["nice"], 10))], "nice"


def run_job(command, env, held):
    """Run COMMAND and return its exit status (negative for a signal), or None if it is missing.

    host-check stays the parent so it can log the job's end. It forwards
    termination to the job; an interrupt from the terminal already reaches the
    job through its process group, so host-check only outlives it.
    """
    try:
        child = subprocess.Popen(command, env=env, pass_fds=held)
    except FileNotFoundError:
        return None
    for signum in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, lambda received, _frame: child.send_signal(received))
    # Set after the spawn: an ignored disposition would be inherited by the job.
    for signum in (signal.SIGINT, signal.SIGQUIT):
        signal.signal(signum, signal.SIG_IGN)
    return child.wait()


def exit_like(returncode):
    """Exit as the job did, dying by its signal so callers see the same status."""
    if returncode >= 0:
        return returncode
    # SIGKILL's disposition cannot be changed, and it never needs resetting.
    if -returncode != signal.SIGKILL:
        signal.signal(-returncode, signal.SIG_DFL)
    os.kill(os.getpid(), -returncode)
    return 128 - returncode


def log_job(queue, record):
    """Append one JSON line to jobs.jsonl in the queue directory; a failure only warns."""
    line = (json.dumps(record, separators=(",", ":")) + "\n").encode()
    try:
        fd = os.open(queue / "jobs.jsonl", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        try:
            written = os.write(fd, line)
        finally:
            os.close(fd)
        if written < len(line):
            say(f"could not log the job: wrote {written} of {len(line)} bytes")
    except OSError as error:
        say(f"could not log the job: {error}")


class Locks:
    """The locks one job holds, in the order it took them; the job's children inherit them."""

    def __init__(self, queue, started):
        self.queue = queue
        self.started = started
        self.owner = ""
        self.held = []

    def wait(self, path, mode, describe):
        """Take the lock at PATH, waiting as long as it takes."""
        fd = open_lock(path)
        wait_for(fd, mode, describe, self.started)
        self.held.append(fd)

    def acquire(self, prefix, count, label):
        """Hold the first free of COUNT slots; others may take a slot ahead of a waiter."""
        next_report = time.monotonic() + 10
        while True:
            number = self.sweep(prefix, count)
            if number:
                return number
            if time.monotonic() >= next_report:
                say(f"waiting for {label} ({int(time.monotonic() - self.started)}s)")
                next_report += 10
            time.sleep(1)

    def sweep(self, prefix, count):
        """Hold the first free slot and record its owner; None when every slot is taken."""
        for number in range(1, count + 1):
            fd = open_lock(self.queue / f"{prefix}-{number}.lock")
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                os.close(fd)
                continue
            stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
            (self.queue / f"{prefix}-{number}.owner").write_text(f"{self.owner} started={stamp}\n")
            self.held.append(fd)
            return number
        return None


def acquire_slots(locks, conf, job_class):
    """Take the slots the class needs and return the global one with the class details."""
    # Classes go build, heavy, global, so no deadlock.
    classes = []
    if job_class == "build":
        n = locks.acquire("build", conf["build_slots"], f"a build slot ({conf['build_slots']} builds at once)")
        classes.append(f"build {n}/{conf['build_slots']}")
    if job_class != "light":
        n = locks.acquire("heavy", conf["heavy_slots"],
                          f"a heavy slot ({conf['heavy_slots']} whole suites or builds at once)")
        classes.append(f"heavy {n}/{conf['heavy_slots']}")
    return locks.acquire("slot", conf["slots"], "a global slot"), classes


def lock_worktree(locks):
    """Take the legacy and worktree locks and return the worktree path."""
    # Jobs from the previous wrapper generation hold this lock exclusively.
    # Shared holders run together but never overlap one of those.
    locks.wait(locks.queue / "lock", fcntl.LOCK_SH, lambda: "legacy validation to finish")
    worktree = worktree_root()
    key = hashlib.sha256(worktree.encode()).hexdigest()
    # Taken before any global slot, so same-worktree waiters consume no slots.
    locks.wait(locks.queue / "worktrees" / f"{key}.lock", fcntl.LOCK_EX,
               lambda: f"worktree {shlex.quote(worktree)}")
    return worktree


def main(argv):
    conf = hostconf.load()
    if not argv or argv[0] in ("--help", "-h"):
        usage(conf)
        return 0
    if os.environ.get("HOST_CHECK_ACTIVE") == "1":
        say("nested invocation refused; wrap the pipeline only once.")
        return 64

    queue = Path(os.environ.get("HOST_CHECK_QUEUE_DIR") or Path.home() / ".cache" / "host-check")
    (queue / "worktrees").mkdir(parents=True, exist_ok=True)
    os.chmod(queue, 0o700)
    os.chmod(queue / "worktrees", 0o700)
    started = time.monotonic()
    locks = Locks(queue, started)
    worktree = lock_worktree(locks)
    job_class = classify(argv)
    locks.owner = (f"pid={os.getpid()} class={job_class} executable={shlex.quote(argv[0])} "
                   f"worktree={shlex.quote(worktree)}")
    slot, classes = acquire_slots(locks, conf, job_class)

    prefix, where = launcher(conf)
    detail = f", {', '.join(classes)}" if classes else ""
    waited = time.monotonic() - started
    say(f"acquired slot {slot} ({job_class}{detail}) after {int(waited)}s; "
        f"running {shlex.quote(argv[0])} ({where})")

    env = dict(os.environ, HOST_CHECK_ACTIVE="1")
    env.setdefault("VITEST_MAX_WORKERS", str(conf["vitest_max_workers"]))
    # The command and its surviving children keep the locks until they exit.
    command = [*prefix, *argv]
    begun = time.gmtime()
    returncode = run_job(command, env, locks.held)
    if returncode is None:
        say(f"command not found: {command[0]}")
        return 127
    log_job(queue, {
        "start": time.strftime("%Y-%m-%dT%H:%M:%SZ", begun),
        "label": os.environ.get("HOST_CHECK_LABEL"),
        "class": job_class,
        "worktree": worktree,
        "command": shlex.join(argv)[:500],
        "wait_s": round(waited, 1),
        "run_s": round(time.monotonic() - started - waited, 1),
        "exit": returncode,
    })
    return exit_like(returncode)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
