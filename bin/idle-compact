#!/usr/bin/env python3
"""Find idle Claude threads in T3 Code to compact before their prompt cache expires.

  idle-compact due [--json]    threads to send /compact now; each is listed once
  idle-compact wake            trigger the janitor's webhook if any thread is due
  idle-compact report [DAYS]   what the compactions listed in the last DAYS (default 7) did

Claude Code caches a conversation for an hour after each API request. Compacting
a large thread inside that hour reads its context from cache at a tenth of the
input price; compacting it after the hour writes the whole context again.

A thread is due when it is a top-level Claude thread that is active or snoozed
(not settled, archived, or deleted), nothing in it or its subagent threads is
running, it holds at least MIN_TOKENS of context, and its last API request was
48 to 56 minutes ago with no compaction since. T3 stops an idle Claude process
after 30 minutes, but a session resumed within the hour still reads its context
from cache, so a stopped session qualifies too.

A timer runs `wake` every five minutes. When a thread is due, it posts to the
local webhook of the T3 scheduled task titled "Idle compaction", which runs a
janitor thread. The janitor runs `due`, sends each thread `/compact`, and
snoozes a snoozed one again, since a completed turn wakes it. `due` records each
thread it lists in ~/.cache/idle-compact/log.jsonl so the next run skips it;
`wake` leaves the log alone. `report` reads that log.
"""
import json
import os
from pathlib import Path
import sqlite3
import sys
from datetime import datetime, timedelta, timezone
from urllib.error import URLError
from urllib.parse import quote
from urllib.request import Request, urlopen

MIN_TOKENS = int(os.environ.get("IDLE_COMPACT_MIN_TOKENS", 100_000))
WINDOW = (timedelta(minutes=48), timedelta(minutes=56))
CACHE_TTL = timedelta(hours=1)
TAIL_BYTES = 4 << 20
DONE_RUNS = ("completed", "cancelled", "interrupted", "failed", "rolled_back")
STATE = Path(os.environ.get("T3_HOME") or Path.home() / ".t3") / "userdata" / "statev2.sqlite"
PROJECTS = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "projects"
LOG = Path.home() / ".cache" / "idle-compact" / "log.jsonl"
TASK_TITLE = "Idle compaction"


def parse_time(text):
    return datetime.fromisoformat(text.replace("Z", "+00:00")) if text else None


def iso(moment):
    return moment.astimezone(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def threads(db):
    """Each live thread with its newest provider thread and whether anything in it is running."""
    running = {row[0] for row in db.execute(
        f"select distinct thread_id from orchestration_v2_projection_runs "
        f"where status not in ({','.join('?' * len(DONE_RUNS))})", DONE_RUNS)}
    providers = {}
    for thread_id, provider, status, payload in db.execute(
            "select thread_id, provider, status, payload_json from orchestration_v2_projection_provider_threads "
            "order by updated_at"):
        providers[thread_id] = (provider, status, json.loads(payload))
    found = []
    for thread_id, title, payload in db.execute(
            "select thread_id, title, payload_json from orchestration_v2_projection_threads "
            "where deleted_at is null and archived_at is null"):
        provider, status, native = providers.get(thread_id, (None, None, {}))
        # a native subagent's child thread has no provider thread; its parent's run covers it
        busy = thread_id in running or status not in (None, "idle") or bool(native.get("pendingBackgroundTasks"))
        found.append({"id": thread_id, "title": title, "thread": json.loads(payload), "provider": provider,
                      "session": (native.get("nativeThreadRef") or {}).get("nativeId"), "busy": busy})
    return found


def busy_parents(found):
    return {t["thread"]["lineage"]["parentThreadId"] for t in found
            if t["busy"] and (t["thread"].get("lineage") or {}).get("parentThreadId")}


def snoozed_until(thread, now):
    until = parse_time(thread.get("snoozedUntil"))
    return until if until and until > now else None


def eligible(t, parents, now):
    thread = t["thread"]
    if t["provider"] != "claudeAgent" or t["busy"] or t["id"] in parents:
        return False
    if (thread.get("lineage") or {}).get("parentThreadId"):
        return False
    return thread.get("settledOverride") != "settled" or snoozed_until(thread, now) is not None


def transcript(session):
    return next(PROJECTS.glob(f"*/{session}.jsonl"), None)


def tail_entries(path):
    """The transcript's entries, newest first, from its last TAIL_BYTES."""
    with path.open("rb") as handle:
        handle.seek(max(0, path.stat().st_size - TAIL_BYTES))
        lines = handle.read().splitlines()
    for line in reversed(lines):
        try:
            yield json.loads(line)
        except ValueError:
            continue


def is_request(entry):
    message = entry.get("message") or {}
    return (entry.get("type") == "assistant" and not entry.get("isSidechain")
            and message.get("usage") and message.get("model") != "<synthetic>")


def last_request(path):
    """(time the last API request was sent, its context tokens), or None after a compaction."""
    usage = None
    for entry in tail_entries(path):
        if usage is None and entry.get("subtype") == "compact_boundary":
            return None
        if usage is None and is_request(entry):
            usage = entry["message"]["usage"]
        elif usage is not None and entry.get("type") == "user" and not entry.get("isSidechain"):
            # the prompt or tool result that started the request
            tokens = sum(usage.get(k) or 0 for k in
                         ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
            return parse_time(entry["timestamp"]), tokens
    return None


def logged():
    if not LOG.exists():
        return []
    return [json.loads(line) for line in LOG.read_text().splitlines() if line.strip()]


def due_thread(t, now, listed):
    path = transcript(t["session"])
    # the transcript is written after every request, so an older file has nothing due
    if path is None or now - datetime.fromtimestamp(path.stat().st_mtime, timezone.utc) > WINDOW[1]:
        return None
    request = last_request(path)
    if request is None or (t["id"], iso(request[0])) in listed:
        return None
    sent, tokens = request
    if tokens < MIN_TOKENS or not WINDOW[0] <= now - sent < WINDOW[1]:
        return None
    until = snoozed_until(t["thread"], now)
    return {"threadId": t["id"], "title": t["title"], "session": t["session"], "tokens": tokens,
            "lastRequestAt": iso(sent), "idleMinutes": int((now - sent).total_seconds() // 60),
            "snoozedUntil": t["thread"]["snoozedUntil"] if until else None}


def pick(db, now):
    found = threads(db)
    parents = busy_parents(found)
    listed = {(e["threadId"], e["lastRequestAt"]) for e in logged()}
    return [d for d in (due_thread(t, now, listed) for t in found if eligible(t, parents, now)) if d]


def due(as_json):
    now = datetime.now(timezone.utc)
    picked = pick(sqlite3.connect(f"file:{STATE}?mode=ro", uri=True), now)
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as log:
        for item in picked:
            log.write(json.dumps({"listedAt": iso(now), **item}) + "\n")
    if as_json:
        print(json.dumps(picked, indent=2))
        return
    for item in picked:
        snooze = f" (snoozed until {item['snoozedUntil']})" if item["snoozedUntil"] else ""
        print(f"{item['threadId']}  {item['tokens'] // 1000}k  idle {item['idleMinutes']}m{snooze}  {item['title']}")
    print(f"{len(picked)} thread{'s' if len(picked) != 1 else ''} due (at least {MIN_TOKENS // 1000}k tokens, "
          f"{WINDOW[0].seconds // 60}-{WINDOW[1].seconds // 60} minutes idle)")


def webhook(db):
    """The local URL of the janitor's webhook task, or None when it has none."""
    row = db.execute("select task_id, webhook_token from scheduled_tasks "
                     "where title = ? and enabled = 1 and webhook_token is not null", (TASK_TITLE,)).fetchone()
    if row is None:
        return None
    origin = json.loads((STATE.parent / "server-runtime.json").read_text())["origin"]
    return f"{origin}/api/hooks/{quote(row[0], safe='')}/{row[1]}"


def wake():
    db = sqlite3.connect(f"file:{STATE}?mode=ro", uri=True)
    picked = pick(db, datetime.now(timezone.utc))
    if not picked:
        return 0
    url = webhook(db)
    if url is None:
        print(f'{len(picked)} due, but no enabled webhook task is titled "{TASK_TITLE}"', file=sys.stderr)
        return 1
    request = Request(url, data=json.dumps({"due": len(picked)}).encode(), method="POST",
                      headers={"content-type": "application/json"})
    try:
        with urlopen(request, timeout=10) as response:
            outcome = response.headers.get("x-t3-hook-outcome")
    except URLError as error:
        print(f"{iso(datetime.now(timezone.utc))}  could not reach T3: {error}", file=sys.stderr)
        return 1
    print(f"{iso(datetime.now(timezone.utc))}  woke the janitor for {len(picked)} thread(s): {outcome}")
    return 0


def boundary_after(path, since):
    for entry in tail_entries(path):
        moment = parse_time(entry.get("timestamp"))
        if moment and moment < since:
            return None
        if entry.get("subtype") == "compact_boundary":
            return entry
    return None


def outcome(item):
    path = transcript(item["session"])
    entry = path and boundary_after(path, parse_time(item["listedAt"]))
    if not entry:
        return "not compacted"
    meta = entry.get("compactMetadata") or {}
    gap = parse_time(entry["timestamp"]) - timedelta(milliseconds=meta.get("durationMs") or 0) \
        - parse_time(item["lastRequestAt"])
    cache = "warm" if gap < CACHE_TTL else "COLD"
    after = f" -> {meta['postTokens'] // 1000}k" if meta.get("postTokens") else ""
    return (f"{meta.get('preTokens', 0) // 1000}k{after}, "
            f"{cache} ({int(gap.total_seconds() // 60)}m after the last request)")


def report(days):
    since = datetime.now(timezone.utc) - timedelta(days=days)
    items = [e for e in logged() if parse_time(e["listedAt"]) >= since]
    for item in items:
        print(f"{item['listedAt']}  {item['tokens'] // 1000}k  {outcome(item)}  {item['title']}")
    print(f"{len(items)} listed in the last {days} days")


def main(argv):
    if argv[:1] == ["due"] and set(argv[1:]) <= {"--json"}:
        due("--json" in argv)
    elif argv == ["wake"]:
        return wake()
    elif argv[:1] == ["report"] and len(argv) <= 2 and (len(argv) == 1 or argv[1].isdigit()):
        report(int(argv[1]) if len(argv) == 2 else 7)
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
