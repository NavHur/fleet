#!/usr/bin/env python3
"""Run each repository's complete suite on a clean checkout of origin/main.

  nightly-gate run [REPO ...] [--force]   run the repos whose main moved; wake the fix task for each that needs it
  nightly-gate report [--json]            each repository's latest result
  nightly-gate ack REPO SHA THREAD        record the fix thread launched for that result

The repositories are in ~/.config/fleet/nightly.json (hosts/<machine>/nightly.json
in fleet), so only a machine with that file runs them. A timer runs `run` every
night. A repository whose origin/main already has a result, other than a checkout
error, is skipped, so quiet nights cost nothing. Otherwise its suite runs through host-check in a fresh
detached worktree, with no caches or untracked files from the clone, and a
failure is run once more: passing the second time makes it flaky.

Each result is posted to GitHub as the `nightly` commit status on that SHA; a
saved result whose status never reached GitHub is posted again on the next run.
A failure, a timeout, a setup error, or a third flaky night in a row needs a
fix. When one has no fix thread yet, `run` posts {"repo": REPO} to the local
webhook of the T3 scheduled task titled "Nightly fix", which reads
`report --json`, launches the fix thread, and records it with `ack`. That thread
keeps covering later failing SHAs until a night needs no fix. An error (fetch or
checkout) is reported every night it is the latest result, whatever its ack.
Results live in ~/.cache/nightly-gate/<repo>/: <sha>.json per SHA run,
latest.json for the latest outcome, fetch errors included.
"""
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import shutil
import sqlite3
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from urllib.error import URLError
from urllib.parse import quote
from urllib.request import Request, urlopen

CONFIG = Path(os.environ.get("NIGHTLY_GATE_CONFIG") or Path.home() / ".config" / "fleet" / "nightly.json")
ROOT = Path(os.environ.get("NIGHTLY_GATE_DIR") or Path.home() / ".cache" / "nightly-gate")
HOST_CHECK = os.environ.get("NIGHTLY_GATE_HOST_CHECK") or str(Path.home() / ".local" / "bin" / "host-check")
STATE = Path(os.environ.get("T3_HOME") or Path.home() / ".t3") / "userdata" / "statev2.sqlite"
TASK_TITLE = "Nightly fix"
FLAKY_LIMIT = 3
TAIL_LINES = 80
TIMEOUT_EXIT = 124
STATUS = {"pass": "success", "flaky": "success", "fail": "failure", "timeout": "failure", "error": "error"}


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def git(clone, *args):
    return subprocess.run(["git", "-C", str(clone), *args], capture_output=True, text=True, check=True).stdout.strip()


def load(path):
    return json.loads(path.read_text()) if path.exists() else None


def latest(name):
    return load(ROOT / name / "latest.json")


def completed(name, sha):
    """The result of the run at that SHA, or None when it never ran."""
    return load(ROOT / name / f"{sha}.json")


def settled(name, sha):
    """The result at that SHA unless its checkout failed, which a later run tries again."""
    result = completed(name, sha)
    return result if result and result["status"] != "error" else None


def no_result(name, sha):
    """Counts no earlier run, so `run --force` runs every SHA again."""
    return None


def write(path, data):
    fd, temp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    with os.fdopen(fd, "w") as out:
        out.write(json.dumps(data, indent=2) + "\n")
    os.replace(temp, path)


def save(result):
    """Make the result its repo's latest; one with a SHA is also that SHA's result.

    latest.json is written first: it holds the current ack, which a reused SHA takes from it.
    """
    folder = ROOT / result["repo"]
    folder.mkdir(parents=True, exist_ok=True)
    write(folder / "latest.json", result)
    if result["sha"]:
        write(folder / f"{result['sha']}.json", result)


@contextmanager
def state_lock(name):
    """Held around each read-modify-write of a repo's results; briefly, unlike the run lock."""
    path = ROOT / name / "state.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def classify(exits):
    """The status of a run from the exit codes of its attempts."""
    if exits[-1] == 0:
        return "pass" if len(exits) == 1 else "flaky"
    return "timeout" if exits[-1] == TIMEOUT_EXIT else "fail"


def broken(result):
    """Whether the result calls for a fix thread, launched or not."""
    if result["status"] == "flaky":
        return result["flakyStreak"] >= FLAKY_LIMIT
    return result["status"] != "pass"


def needs_fix(result):
    if result is None:
        return False
    if result["status"] == "error":
        return True
    return not result.get("ack") and broken(result)


def carried_ack(previous, result):
    """A fix thread launched for an earlier SHA still covers main until a night needs no fix."""
    if not previous or not previous.get("ack"):
        return None
    return previous["ack"] if broken(previous) and broken(result) else None


def fresh_checkout(clone, path, sha):
    if path.exists():
        subprocess.run(["git", "-C", str(clone), "worktree", "remove", "--force", str(path)], capture_output=True)
        shutil.rmtree(path, ignore_errors=True)
    git(clone, "worktree", "prune")
    git(clone, "worktree", "add", "--detach", str(path), sha)


def drop_checkout(clone, path):
    subprocess.run(["git", "-C", str(clone), "worktree", "remove", "--force", str(path)], capture_output=True)
    shutil.rmtree(path, ignore_errors=True)


def attempt(repo, checkout, log, number):
    command = f"{repo['setup']} && {repo['suite']}" if repo.get("setup") else repo["suite"]
    minutes = repo.get("timeoutMinutes", 60)
    with log.open("a") as out:
        out.write(f"\n== nightly-gate attempt {number} at {now()}: {command}\n")
        out.flush()
        return subprocess.run([HOST_CHECK, "timeout", "--kill-after=30s", f"{minutes}m", "bash", "-lc", command],
                              cwd=checkout, stdout=out, stderr=subprocess.STDOUT).returncode


def tail(log):
    return "\n".join(log.read_text(errors="replace").splitlines()[-TAIL_LINES:])


def post_status(repo, result):
    """Post the result as the nightly commit status: whether GitHub has it."""
    if not repo.get("github"):
        return True
    description = f"{result['status']} on devbox in {result['minutes']} min"
    if result["status"] == "error":
        description = f"setup error: {result['error']}"[:140]
    posted = subprocess.run(["gh", "api", "-X", "POST", f"repos/{repo['github']}/statuses/{result['sha']}",
                             "-f", f"state={STATUS[result['status']]}", "-f", "context=nightly",
                             "-f", f"description={description}"], capture_output=True, text=True)
    if posted.returncode != 0:
        print(f"{result['repo']}: could not post the nightly status: {posted.stderr.strip()}", file=sys.stderr)
    return posted.returncode == 0


def fetch_main(clone):
    git(clone, "fetch", "--quiet", "origin", "main")
    return git(clone, "rev-parse", "origin/main")


def suite_status(repo, clone, sha, log):
    """Run the suite on a fresh checkout, once more if it fails: (status, exits, error)."""
    checkout = log.parent / "checkout"
    try:
        fresh_checkout(clone, checkout, sha)
        exits = [attempt(repo, checkout, log, 1)]
        if exits[0] != 0:
            exits.append(attempt(repo, checkout, log, 2))
        return classify(exits), exits, None
    except (subprocess.CalledProcessError, OSError) as error:
        detail = getattr(error, "stderr", None) or str(error)
        return "error", [], f"checkout failed: {detail.strip()}"
    finally:
        drop_checkout(clone, checkout)


def flaky_streak(previous, status):
    if status != "flaky":
        return 0
    return previous["flakyStreak"] + 1 if previous and previous["status"] == "flaky" else 1


def record(result):
    """Save a new result, keeping the fix thread that still covers it."""
    with state_lock(result["repo"]):
        result["ack"] = carried_ack(latest(result["repo"]), result)
        save(result)
    return result


def reuse(name, sha):
    """Make the result already at that SHA the latest again, under the fix thread that covers main now."""
    with state_lock(name):
        result = completed(name, sha)
        result["ack"] = carried_ack(latest(name), result)
        save(result)
    return result


def publish(repo, result):
    """Post the saved result's commit status unless GitHub has it, and record that it does."""
    if result.get("posted") or not post_status(repo, result):
        return result
    return mark_posted(result["repo"], result["sha"])


def mark_posted(name, sha):
    """Record that GitHub has the status at that SHA, leaving the latest result unless it is that SHA's."""
    with state_lock(name):
        current = latest(name)
        if current and current["sha"] == sha:
            current["posted"] = True
            save(current)
            return current
        result = completed(name, sha)
        result["posted"] = True
        write(ROOT / name / f"{sha}.json", result)
    return result


def repost(name, repo):
    """Post each saved result whose status never reached GitHub, without running its suite again."""
    for path in (ROOT / name).glob("*.json"):
        result = load(path)
        if path.name != "latest.json" and not result["posted"]:
            publish(repo, result)


def fetch_error(name, started, error):
    return {"repo": name, "sha": None, "startedAt": started, "minutes": 0, "status": "error",
            "error": f"fetch failed: {error.stderr.strip()}", "finishedAt": now(), "flakyStreak": 0}


def run_suite(name, repo, clone, sha, started_at):
    log = ROOT / name / f"{sha}.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    log.write_text("")
    started = datetime.now(timezone.utc)
    status, exits, error = suite_status(repo, clone, sha, log)
    result = {"repo": name, "sha": sha, "startedAt": started_at, "status": status, "exits": exits,
              "log": str(log), "finishedAt": now(),
              "minutes": round((datetime.now(timezone.utc) - started).total_seconds() / 60, 1),
              "flakyStreak": flaky_streak(latest(name), status), "posted": False}
    if error:
        result["error"] = error
    if status != "pass":
        result["tail"] = tail(log)
    print(f"{name}: {sha[:9]} {status} in {result['minutes']} min")
    return record(result)


def run_repo(name, repo, earlier):
    """Run one repository unless `earlier` finds a result for its main: the result."""
    clone = Path(os.path.expanduser(repo["clone"]))
    started = now()
    try:
        sha = fetch_main(clone)
    except subprocess.CalledProcessError as error:
        return record(fetch_error(name, started, error))
    known = earlier(name, sha)
    if known:
        print(f"{name}: {sha[:9]} already {known['status']}, skipped")
        return publish(repo, reuse(name, sha))
    return publish(repo, run_suite(name, repo, clone, sha, started))


def webhook():
    """The local URL of the fix task's webhook, or None when it has none."""
    if not STATE.exists():
        return None
    db = sqlite3.connect(f"file:{STATE}?mode=ro", uri=True)
    row = db.execute("select task_id, webhook_token from scheduled_tasks "
                     "where title = ? and enabled = 1 and webhook_token is not null", (TASK_TITLE,)).fetchone()
    if row is None:
        return None
    origin = json.loads((STATE.parent / "server-runtime.json").read_text())["origin"]
    return f"{origin}/api/hooks/{quote(row[0], safe='')}/{row[1]}"


def wake(name):
    url = webhook()
    if url is None:
        print(f'{name} needs a fix, but no enabled webhook task is titled "{TASK_TITLE}"', file=sys.stderr)
        return 1
    request = Request(url, data=json.dumps({"repo": name}).encode(), method="POST",
                      headers={"content-type": "application/json"})
    try:
        with urlopen(request, timeout=10) as response:
            outcome = response.headers.get("x-t3-hook-outcome")
    except URLError as error:
        print(f"could not reach T3: {error}", file=sys.stderr)
        return 1
    print(f"woke the fix task for {name}: {outcome}")
    return 0


def gate(name, repo, earlier):
    """Run one repository and wake the fix task right away if it needs one: 1 when the wake fails."""
    repost(name, repo)
    result = run_repo(name, repo, earlier)
    return wake(name) if needs_fix(result) else 0


def run(names, earlier):
    repos = json.loads(CONFIG.read_text())["repos"]
    unknown = set(names) - set(repos)
    if unknown:
        print(f"not in {CONFIG}: {', '.join(sorted(unknown))}", file=sys.stderr)
        return 2
    ROOT.mkdir(parents=True, exist_ok=True)
    with (ROOT / "lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("another nightly-gate run is in progress", file=sys.stderr)
            return 1
        return max([gate(name, repos[name], earlier) for name in names or repos], default=0)


def results():
    names = json.loads(CONFIG.read_text())["repos"] if CONFIG.exists() else {}
    return [dict(r, needsFix=needs_fix(r)) for r in map(latest, names) if r]


def report_json():
    print(json.dumps(results(), indent=2))
    return 0


def report_text():
    for r in results():
        print(report_line(r))
    return 0


def report_line(r):
    fix = "  NEEDS FIX" if r["needsFix"] else ""
    ack = f"  fix thread {r['ack']['thread']}" if r.get("ack") else ""
    return f"{r['repo']:14} {(r['sha'] or '')[:9]}  {r['status']:7} {r['finishedAt']}{fix}{ack}"


def ack(name, sha, thread):
    with state_lock(name):
        result = latest(name)
        if result is None or result["sha"] != sha:
            print(f"{name}'s latest result is not {sha}", file=sys.stderr)
            return 1
        result["ack"] = {"thread": thread, "sha": sha, "at": now()}
        save(result)
    return 0


def main(argv):
    if argv[:1] == ["run"]:
        earlier = no_result if "--force" in argv else settled
        return run([a for a in argv[1:] if a != "--force"], earlier)
    if argv == ["report"]:
        return report_text()
    if argv == ["report", "--json"]:
        return report_json()
    if argv[:1] == ["ack"] and len(argv) == 4:
        return ack(*argv[1:])
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
