#!/usr/bin/env bash
# Make this machine's agent skills and shared host files match the fleet repo.
#
#   bin/sync [--host NAME]            show the plan, change nothing
#   bin/sync [--host NAME] --apply    pull the repo, then carry out the plan
#
# Own skills (skills/*) are symlinked into ~/.agents/skills, which Codex,
# Cursor, and OpenCode read, and into ~/.claude/skills for Claude Code.
# Third-party skills (third-party.json) are installed and updated with
# `npx skills`. The files listed in `links` are symlinked into place,
# ~/.config/host-validation.md is generated, the release binaries in
# binaries.json are installed into ~/.local/bin, the host-check guard is
# registered as a hook for each agent, and OpenCode servers older than their
# plugins are restarted when idle. NAME picks hosts/NAME; it is needed
# only when this machine's hostname is not listed in a hosts/*/host.json.
# Anything replaced is moved to ~/.skills-backups/fleet-<timestamp>/.
# Written for bash 3.2 so it runs on stock macOS.
set -euo pipefail

# Everything runs inside main, so bash has parsed the whole script before
# `git pull` can replace it.
main() {
FLEET=$(cd "$(dirname "$0")/.." && pwd)
APPLY=0
HOST=""
while [ $# -gt 0 ]; do
  case "$1" in
    --apply) APPLY=1 ;;
    --host) HOST=${2:-}; shift ;;
    --host=*) HOST=${1#--host=} ;;
    -h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

# This machine's name: --host, else the host.json link from an earlier run,
# else a hostname listed in hosts/*/host.json.
if [ -z "$HOST" ] && [ -L "$HOME/.config/fleet/host.json" ]; then
  HOST=$(basename "$(dirname "$(readlink "$HOME/.config/fleet/host.json")")")
fi
if [ -z "$HOST" ]; then
  HOST=$(python3 - "$FLEET/hosts" "$(hostname)" "$(hostname -s)" <<'PY'
import json, pathlib, sys
for conf in sorted(pathlib.Path(sys.argv[1]).glob("*/host.json")):
    if set(json.loads(conf.read_text()).get("hostnames", [])) & set(sys.argv[2:]):
        print(conf.parent.name)
        break
PY
)
fi
if [ -z "$HOST" ] || [ ! -f "$FLEET/hosts/$HOST/host.json" ]; then
  echo "Unknown machine. Pass --host with one of: $(cd "$FLEET/hosts" && ls | tr '\n' ' ')" >&2
  exit 2
fi

AGENTS_DIR="$HOME/.agents/skills"
CLAUDE_DIR="$HOME/.claude/skills"
# Folders the skills CLI no longer installs into globally; same-named copies
# there shadow or duplicate ~/.agents/skills.
EXTRA_DIRS="$HOME/.codex/skills $HOME/.cursor/skills $HOME/.config/opencode/skills"
# Managed by Claude.ai sync and by Codex itself.
PROTECTED="synced .system"
NPX_AGENTS="claude-code codex cursor opencode"
BACKUP="$HOME/.skills-backups/fleet-$(date +%Y%m%d-%H%M%S)"

if [ "$APPLY" = 1 ]; then
  git -C "$FLEET" pull --ff-only --quiet
fi

OWN=$(cd "$FLEET/skills" && ls)
THIRD=$(python3 -c 'import json,sys
for src,names in json.load(open(sys.argv[1]))["sources"].items():
    for n in names: print(src, n)' "$FLEET/third-party.json")
THIRD_NAMES=$(echo "$THIRD" | awk '{print $2}')
LOCKED=$(python3 -c 'import json,os
p=os.path.expanduser("~/.agents/.skill-lock.json")
print("\n".join(json.load(open(p))["skills"]) if os.path.exists(p) else "")')

has() { printf '%s\n' "$2" | grep -qxF -- "$1"; }
is_protected() { case " $PROTECTED " in *" $1 "*) return 0 ;; esac; return 1; }
short() { case "$1" in "$HOME"/*) echo "~/${1#"$HOME"/}" ;; *) echo "$1" ;; esac; }
say() { printf '  %-10s %s\n' "$1" "$2"; }
exists() { [ -e "$1" ] || [ -L "$1" ]; }

PLANNED=0
step() { PLANNED=$((PLANNED + 1)); say "$1" "$2"; [ "$APPLY" = 1 ]; }

# Move a path into the backup folder, keeping its home-relative layout.
retire() {
  step "$2" "$(short "$1")" || return 0
  local dest="$BACKUP/${1#"$HOME"/}"
  mkdir -p "$(dirname "$dest")"
  mv "$1" "$dest"
}

# Point $2 at $1, retiring whatever is there now.
ensure_link() {
  [ -L "$2" ] && [ "$(readlink "$2")" = "$1" ] && return 0
  exists "$2" && retire "$2" replace
  step link "$(short "$2") -> $(short "$1")" || return 0
  mkdir -p "$(dirname "$2")"
  ln -s "$1" "$2"
}

echo "== Own skills ($(echo "$OWN" | wc -l | tr -d ' ') in $(short "$FLEET")/skills)"
for name in $OWN; do
  ensure_link "$FLEET/skills/$name" "$AGENTS_DIR/$name"
  ensure_link "$FLEET/skills/$name" "$CLAUDE_DIR/$name"
done

echo "== Third-party skills ($(echo "$THIRD_NAMES" | wc -l | tr -d ' ') in third-party.json)"
MISSING=""
for name in $THIRD_NAMES; do
  agents_entry="$AGENTS_DIR/$name"
  if has "$name" "$LOCKED" && [ -d "$agents_entry" ] && [ ! -L "$agents_entry" ]; then
    ensure_link "../../.agents/skills/$name" "$CLAUDE_DIR/$name"
    continue
  fi
  # Present but not installed by the skills CLI (for example a manual copy):
  # back it up so the CLI can install a tracked copy in its place.
  for path in "$agents_entry" "$CLAUDE_DIR/$name"; do
    if exists "$path"; then retire "$path" reinstall; fi
  done
  step install "$name" || true
  MISSING="$MISSING $name"
done
for name in $LOCKED; do
  has "$name" "$THIRD_NAMES" && continue
  step forget "$name (skills lock entry not in third-party.json)" || continue
  FORGET="${FORGET:-} $name"
done

echo "== Unmanaged entries"
for dir in "$AGENTS_DIR" "$CLAUDE_DIR" $EXTRA_DIRS; do
  [ -d "$dir" ] || continue
  for path in "$dir"/* "$dir"/.[!.]*; do
    exists "$path" || continue
    name=$(basename "$path")
    is_protected "$name" && continue
    if [ "$dir" = "$AGENTS_DIR" ] || [ "$dir" = "$CLAUDE_DIR" ]; then
      has "$name" "$OWN" && continue
      has "$name" "$THIRD_NAMES" && continue
      retire "$path" unmanaged
    elif has "$name" "$OWN" || has "$name" "$THIRD_NAMES"; then
      retire "$path" duplicate
    else
      retire "$path" unmanaged
    fi
  done
done

echo "== Host files (hosts/$HOST)"
SLICE_CHANGED=0
while read -r home_path repo_path condition; do
  case "$home_path" in ''|'#'*) continue ;; esac
  repo_path=$(echo "$repo_path" | sed "s/{host}/$HOST/g")
  [ -e "$FLEET/$repo_path" ] || continue
  case "$condition" in if:*) [ -e "$HOME/${condition#if:}" ] || continue ;; esac
  before=$(readlink "$HOME/$home_path" 2>/dev/null || true)
  ensure_link "$FLEET/$repo_path" "$HOME/$home_path"
  case "$home_path" in
    *.slice|*.service|*.timer|*.d/*.conf) [ "$before" = "$FLEET/$repo_path" ] || SLICE_CHANGED=1 ;;
  esac
done < "$FLEET/links"

# Shared policy plus this machine's section, as one file agents can read.
validation="$HOME/.config/host-validation.md"
generated=$(mktemp)
{
  echo "<!-- Generated by fleet bin/sync from config/host-validation.md and"
  echo "     hosts/$HOST/host-validation.md. Edit those and re-run bin/sync. -->"
  echo
  cat "$FLEET/config/host-validation.md"
  echo
  cat "$FLEET/hosts/$HOST/host-validation.md"
} >"$generated"
if [ -L "$validation" ] || ! cmp -s "$generated" "$validation"; then
  exists "$validation" && retire "$validation" replace
  if step write "$(short "$validation")"; then
    mkdir -p "$(dirname "$validation")"
    cp "$generated" "$validation"
  fi
fi
rm -f "$generated"

echo "== Agent hooks and settings"
hook_args=("$BACKUP")
[ "$APPLY" = 1 ] && hook_args+=(--apply)
hook_plan=$(python3 "$FLEET/lib/fleet/hooks.py" "${hook_args[@]}")
if [ -n "$hook_plan" ]; then
  echo "$hook_plan"
  PLANNED=$((PLANNED + $(echo "$hook_plan" | grep -cE '^  ((un)?hook|set) ' || true)))
fi

echo "== OpenCode servers"
server_args=()
[ "$APPLY" = 1 ] && server_args+=(--apply)
server_plan=$(python3 "$FLEET/lib/fleet/opencode_servers.py" ${server_args[@]+"${server_args[@]}"})
if [ -n "$server_plan" ]; then
  echo "$server_plan"
  PLANNED=$((PLANNED + $(echo "$server_plan" | grep -cE '^  restart ' || true)))
fi

echo "== Claude Code plugins"
plugin_args=("$FLEET/claude-plugins.json")
[ "$APPLY" = 1 ] && plugin_args+=(--apply)
plugin_plan=$(python3 "$FLEET/lib/fleet/claude_plugins.py" "${plugin_args[@]}")
if [ -n "$plugin_plan" ]; then
  echo "$plugin_plan"
  PLANNED=$((PLANNED + $(echo "$plugin_plan" | grep -cE '^  (market|plugin) ' || true)))
fi
if [ "$APPLY" = 1 ] && [ "$SLICE_CHANGED" = 1 ] && command -v systemctl >/dev/null; then
  systemctl --user daemon-reload
fi

# Wakes the idle-compaction janitor (bin/idle-compact). launchd gets a copy, not
# a link, so it never has to follow one into the repo.
echo "== Idle-compaction timer"
if [ "$(uname)" = Darwin ]; then
  agent="$HOME/Library/LaunchAgents/dev.pnav.fleet.idle-compact.plist"
  if ! cmp -s "$FLEET/config/idle-compact/dev.pnav.fleet.idle-compact.plist" "$agent" \
    && step load "$(short "$agent")"; then
    launchctl bootout "gui/$(id -u)" "$agent" 2>/dev/null || true
    mkdir -p "$(dirname "$agent")"
    cp "$FLEET/config/idle-compact/dev.pnav.fleet.idle-compact.plist" "$agent"
    launchctl bootstrap "gui/$(id -u)" "$agent"
  fi
elif command -v systemctl >/dev/null && ! systemctl --user is-enabled --quiet idle-compact.timer 2>/dev/null \
  && step enable "idle-compact.timer"; then
  systemctl --user enable --now idle-compact.timer
fi

# Registers a runner for each repository in hosts/<machine>/runners.json (bin/actions-runners),
# and refreshes installed runners whose job environment changed since they were registered.
echo "== Actions runners"
if [ -e "$HOME/.config/fleet/runners.json" ] && command -v systemctl >/dev/null; then
  for name in $("$FLEET/bin/actions-runners" missing); do
    step register "$name" || continue
    "$FLEET/bin/actions-runners" install "$name"
  done
  for name in $("$FLEET/bin/actions-runners" stale); do
    step refresh "$name" || continue
    "$FLEET/bin/actions-runners" refresh "$name"
  done
fi

echo "== Release binaries"
binary_args=("$FLEET/binaries.json" "$BACKUP")
[ "$APPLY" = 1 ] && binary_args+=(--apply)
binary_plan=$(python3 "$FLEET/lib/fleet/binaries.py" "${binary_args[@]}")
if [ -n "$binary_plan" ]; then
  echo "$binary_plan"
  PLANNED=$((PLANNED + $(echo "$binary_plan" | grep -cE '^  (binary|replace) ' || true)))
fi

echo "== Node dependencies"
for pkg in "$FLEET"/skills/*/package.json "$FLEET"/lib/*/package.json; do
  [ -e "$pkg" ] || continue
  dir=$(dirname "$pkg")
  [ -d "$dir/node_modules" ] && continue
  step npm-deps "$(short "$dir")" || continue
  if command -v pnpm >/dev/null; then
    (cd "$dir" && pnpm install --frozen-lockfile --silent)
  else
    (cd "$dir" && npx --yes pnpm install --frozen-lockfile --silent)
  fi
done

# Codex metadata, the principles index, and instruction pointers depend on
# what is installed, so --apply runs them after the installs below.
if [ "$APPLY" = 0 ]; then
  echo "== After install"
  post_plan=$(python3 "$FLEET/lib/fleet/post_install.py" "$BACKUP")
  if [ -n "$post_plan" ]; then
    echo "$post_plan"
    PLANNED=$((PLANNED + $(echo "$post_plan" | grep -c . || true)))
  fi
  echo
  [ "$PLANNED" = 0 ] && echo "Already in sync."
  echo "Dry run: nothing changed. Re-run with --apply to carry out the plan."
  echo "--apply also updates every third-party skill to its latest version."
  exit 0
fi

for name in ${FORGET:-}; do
  npx --yes skills remove -g -y "$name" </dev/null >/dev/null
done

# Print "<source> <skill>..." for each source with skills to install.
missing_by_source() {
  echo "$THIRD" | while read -r src name; do
    case " $MISSING " in *" $name "*) echo "$src $name" ;; esac
  done | awk '{a[$1]=a[$1]" "$2} END {for (s in a) print s a[s]}'
}

# Keep going when one source fails, and report every failure at the end.
FAILED=""
if [ -n "$MISSING" ]; then
  while read -r src names; do
    echo "== npx skills add $src:$names"
    # shellcheck disable=SC2086
    if ! npx --yes skills add "$src" -g -y -a $NPX_AGENTS -s $names </dev/null; then
      FAILED="$FAILED $src"
    fi
  done < <(missing_by_source)
fi

echo "== npx skills update"
# shellcheck disable=SC2086
npx --yes skills update -g -y $THIRD_NAMES </dev/null || FAILED="$FAILED update"

echo "== After install"
python3 "$FLEET/lib/fleet/post_install.py" "$BACKUP" --apply

if [ -d "$BACKUP" ]; then echo "Retired entries are in $(short "$BACKUP")"; fi
if [ -n "$FAILED" ]; then
  echo "Failed:$FAILED. Fix third-party.json or the network, then re-run." >&2
  exit 1
fi
echo "Done."
}

main "$@"
